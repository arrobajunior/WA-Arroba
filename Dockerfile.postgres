FROM node:24.21.0-bookworm-slim
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3210 DATA_DIR=/app/data
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates ffmpeg && rm -rf /var/lib/apt/lists/* \
    && git config --system url."https://github.com/".insteadOf ssh://git@github.com/
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY --chown=node:node media-storage.mjs media-input.mjs media-relay.mjs remote-media.mjs instance-settings.mjs image-convert.mjs compatibility-api.mjs server.mjs store.mjs auth.mjs transport.mjs branding.mjs alert-email.mjs connection-alerts.mjs incident-history.mjs instance-activity.mjs ./
COPY --chown=node:node public ./public
COPY --chown=node:node postgres/accounts.mjs postgres/auth-state.mjs postgres/branding.mjs postgres/compatibility-api.mjs postgres/connection-alerts.mjs postgres/control-api.mjs postgres/database.mjs postgres/http.mjs postgres/incident-history.mjs postgres/instance-activity.mjs postgres/instances.mjs postgres/message-queue.mjs postgres/panel-messages.mjs postgres/persistence-crypto.mjs postgres/runtime.mjs postgres/serial-tasks.mjs postgres/server.mjs postgres/store.mjs postgres/transport-ownership.mjs postgres/transport.mjs postgres/validation.mjs postgres/manifest.json ./postgres/
COPY --chown=node:node scripts/start-postgres.mjs ./scripts/start-postgres.mjs
RUN mkdir /app/data && chown node:node /app/data && chmod 700 /app/data
USER node
EXPOSE 3210
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD node -e "fetch('http://127.0.0.1:'+process.env.PORT+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "scripts/start-postgres.mjs"]
